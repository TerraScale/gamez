AUTH_SECRET=dev-only-secret-change-me

# ---- Optional (wave B, see docs/secrets.md). Leave commented to use the
# local stub OAuth provider on localhost / *.ts.net hosts.
# GOOGLE_CLIENT_ID=<your Google OAuth web client id>
# GOOGLE_CLIENT_SECRET=<your Google OAuth client secret>
# DISCORD_CLIENT_ID=<your Discord application id>
# DISCORD_CLIENT_SECRET=<your Discord OAuth2 client secret>
# Apple is stub-only in wave B; these are reserved for the real flow.
# APPLE_CLIENT_ID=<Services ID>
# APPLE_TEAM_ID=<team id>
# APPLE_KEY_ID=<key id>
# APPLE_PRIVATE_KEY=<contents of the .p8 key>
# "1" = stub OAuth provider + /api/dev/* on any host (never in production), "0" = never.
# OAUTH_STUB=
# Comma-separated account ids allowed on /api/admin/*.
# ADMIN_ACCOUNT_IDS=
# Chat moderation: llama-guard (needs the AI binding) | stub | off.
# MODERATION=stub
